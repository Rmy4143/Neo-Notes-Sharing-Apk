# NEO NOTES Backend Server Environment Variables
PORT=5000

# NitroFlare Storage Credentials (Server-side ONLY)
# Never expose, share, or hard-code this hash in client apps or the Android APK!
NITROFLARE_USER_HASH=your_nitroflare_user_hash_here

# Brevo Transactional Email Integration (Server-side ONLY)
# Used to deliver real 6-digit verification OTPs to students.
# Never expose this API key inside Android APK, BuildConfig, or client code!
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=verify@neonotes.edu
BREVO_SENDER_NAME=NEO NOTES Security

# Secret salt for server-side OTP hashing (SHA-256)
OTP_SECRET=neonotes_secure_otp_salt_secret_2026

# Optional: Database Connection String
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=password
# DB_NAME=neonotes
